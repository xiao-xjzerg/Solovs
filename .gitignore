# Publication allowlist: update .publish-policy.json and matching exceptions together.
*
!/.gitattributes
!/.githooks/
!/.githooks/pre-commit
!/.githooks/pre-push
!/.gitignore
!/.node-version
!/.publish-policy.json
!/README.md
!/index.html
!/package.json
!/scripts/
!/scripts/check-public.mjs
!/style.css
!/src/
!/src/**
!/assets/
!/assets/**
!/tools/
!/tools/**

# Local files and sensitive data stay outside Git.
.git/
.agents/
.codex/
node_modules/
tests/
test/
tmp/
qa/
coverage/
test-results/
playwright-report/
backups/
dist/
artifacts/
_packs/
2D_version/
DEMO.html
*prompt*
agent.md
AGENTS.md
PLAN.md
RELEASE_DESIGN.md
.env
.env.*
!.env.example
*.sqlite*
*.db
*.db-*
*.xlsx
*.xls
*.pem
*.key
*.pfx
*.p12
*.zip
*.log
*.tmp
*.temp
*.pyc
.DS_Store
